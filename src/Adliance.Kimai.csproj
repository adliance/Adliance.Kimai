<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>Adliance.Kimai</AssemblyName>
    <RootNamespace>Adliance.Kimai</RootNamespace>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0.0</FileVersion>
    <Authors>Hannes Sachsenhofer, Adrian Fürschuß</Authors>
    <Company>Adliance GmbH</Company>
    <Product>Adliance.Kimai</Product>
    <Description>Takes Kimai time entries and generates nice looking HTML reports.</Description>
    <Copyright>Adliance GmbH</Copyright>
    <PackageProjectUrl>https://www.adliance.net</PackageProjectUrl>

    <!-- .NET tool -->
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>adliance.kimai</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>Adliance.Kimai</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Adliance.Buddy.CodeStyle" Version="8.0.0.10"/>
    <PackageReference Include="System.CommandLine" Version="2.0.2"/>
  </ItemGroup>

</Project>
